[Unit]
Description=Claude Code remote control (restarts itself after a drop or reboot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/ixOS
Environment=PATH=%h/.local/bin:%h/.nvm/versions/node/v20.20.2/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/claude remote-control
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
